# ── Echo Backend — environment variables ────────────────────────────────────
# Copy to .env and fill in. Everything below runs on FREE tiers — no GPU, no
# paid AI APIs (no OpenAI, no Cartesia).

# ── Supabase (auth + database, free tier) ────────────────────────────────────
# supabase.com → project → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Groq (STT + LLM, free tier — no card required) ───────────────────────────
# console.groq.com → API Keys. Serves Whisper Large-v3 + Llama 3.3 70B.
# Free tier: ~14,400 requests/day.
GROQ_API_KEY=

# ── Audio delivery analysis (optional, FREE — Google AI Studio) ──────────────
# aistudio.google.com → Get API key (starts with "AIza", free tier, no card).
# Gemini Flash listens to the user's ACTUAL audio (tone, hesitation, per-word
# pronunciation) and powers the word heatmap, live tips, and scorecard depth.
# Leave empty to disable — the app works fine without it, just loses this layer.
# NOTE: audio-capable Gemma 4 variants aren't served by the hosted API, which
# is why the default model is Gemini Flash. Don't set GEMMA_AUDIO_MODEL unless
# you know the model id exists on your key ("gemini-flash-latest" is evergreen).
GEMINI_API_KEY=
# GEMMA_AUDIO_MODEL=gemini-flash-latest

# ── Redis (optional session store, free tier) ────────────────────────────────
# console.upstash.com → Redis. Not required for single-instance dev.
REDIS_URL=

# ── TTS ──────────────────────────────────────────────────────────────────────
# edge   → Microsoft Edge Neural TTS (FREE, default)
# silent → no audio (AI-logic testing only)
DEV_TTS=edge

# ── Admin panel ──────────────────────────────────────────────────────────────
# Comma-separated emails allowed into the admin dashboard at GET /admin.
# (Alternatively set users.is_admin = true in the DB.) These accounts must exist
# as normal Supabase users — they sign in with their email/password.
ADMIN_EMAILS=ask.hamnazahid@gmail.com

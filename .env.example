# Core
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ASR
ASR_MODEL=whisper-large-v3-turbo

# LLM providers
LLM_PROVIDER=groq  # groq|cerebras|openrouter
LLM_CONVERSATION_PREFER_CEREBRAS=false
CONVERSATION_MODEL=openai/gpt-oss-20b
FEEDBACK_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b

# Cerebras (OpenAI-compatible)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_CONVERSATION_MODEL=qwen-3-32b
CEREBRAS_FEEDBACK_MODEL=llama-3.3-70b
CEREBRAS_FAST_MODEL=qwen-3-8b

# OpenRouter (fastest routing)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CONVERSATION_MODEL=qwen/qwen-2.5-7b-instruct:free
OPENROUTER_FEEDBACK_MODEL=moonshotai/kimi-k2:free
OPENROUTER_FAST_MODEL=qwen/qwen-2.5-7b-instruct:free

# TTS
TTS_ENGINE=edge        # edge|piper|sapi|cartesia|silent
TTS_PRIMARY=edge
PIPER_VOICES_DIR=./voices/piper
PIPER_MODEL=en_US-amy-medium.onnx
PIPER_MODEL_JSON=en_US-amy-medium.onnx.json
PIPER_SAMPLE_RATE=24000
# Where the Piper voice is downloaded from (change for a different voice/dir).
PIPER_BASE_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium

# Delivery
MAX_DELIVERY_ANALYSES=3
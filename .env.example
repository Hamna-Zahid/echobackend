# ── EchoCoach Backend — required environment variables ──────────────────────
# Copy this file to .env and fill in all values before starting the server.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Gemini (primary LLM — FREE) ──────────────────────────────────────────────
# aistudio.google.com → Get API Key (free, no card needed)
# Free tier: 15 RPM, 1 million tokens/day on gemini-2.0-flash
GEMINI_API_KEY=

# ── Groq (STT + LLM fallback — FREE) ─────────────────────────────────────────
# console.groq.com → API Keys → Create key
# Free tier: 14,400 requests/day, Whisper STT + Llama fallback
GROQ_API_KEY=your-groq-api-key

# ── Redis (session state) ─────────────────────────────────────────────────────
# console.upstash.com → Create Database → Redis → copy REST URL
# Free tier: 10,000 commands/day
REDIS_URL=redis://default:your-redis-password@your-redis-host.upstash.io:6379

# ── TTS mode ─────────────────────────────────────────────────────────────────
# kokoro   → Kokoro-82M local neural TTS (FREE, runs on CPU — RECOMMENDED)
# edge     → Microsoft Edge Neural TTS (FREE, no key — fallback)
# silent   → No audio at all (AI logic testing only)
DEV_TTS=kokoro

# ── Kokoro voice selection (optional — defaults shown) ───────────────────────
# American voices: af_bella, af_sarah, am_adam, am_michael
# British voices:  bf_emma, bf_isabella, bm_george, bm_lewis
KOKORO_VOICE_AMERICAN=af_bella
KOKORO_VOICE_BRITISH=bf_emma

# ── Cartesia TTS (optional paid upgrade) ─────────────────────────────────────
# Only needed if you set DEV_TTS=cartesia. Kokoro is free and comparable quality.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_AMERICAN=
CARTESIA_VOICE_ID_BRITISH=
